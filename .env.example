# laga-web environment. Copy to .env. Public vars are exposed to the browser,
# so this holds ONLY the API base URL — never secrets.

# Base URL of laga-api's versioned API. Include the /api/v1 prefix.
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Production only (adapter-node): the site's own origin, required by SvelteKit's
# CSRF protection so form POSTs (login, create tournament) are accepted.
# Not needed for `pnpm dev`.
# ORIGIN=https://your-domain
